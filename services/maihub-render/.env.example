# Sao chép thành .env (không commit). Xem README.md.
# Tên miền: mặc định dùng sslip.io với IP máy chủ, ví dụ IP 203.0.113.10 -> render-203-0-113-10.sslip.io
RENDER_DOMAIN=render-203-0-113-10.sslip.io
# Dán kết quả của `npm run keygen -- <tên>`; nhiều khoá thì thêm cặp "tên":"hash" vào cùng JSON.
RENDER_API_KEYS='{"maihub-1":"<sha256-hex-cua-khoa>"}'

# Worker: HyperFrames + Chrome + FFmpeg. Chạy cắt mạng, root filesystem chỉ đọc (xem docker-compose.yml).
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
COPY scripts ./scripts
RUN npx tsc -p tsconfig.json \
    && npm prune --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim
ENV HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 HYPERFRAMES_SKIP_SKILLS=1 NPM_CONFIG_UPDATE_NOTIFIER=false NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg fonts-noto-core fonts-noto-color-emoji ca-certificates \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
      libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 \
    && rm -rf /var/lib/apt/lists/*
# HyperFrames ghim phiên bản; Chrome cài ở /opt/hf (ai cũng đọc được) và trỏ HYPERFRAMES_BROWSER_PATH tới đó
RUN npm i -g --no-audit --no-fund hyperframes@0.8.181 \
    && HOME=/opt/hf hyperframes browser ensure \
    && ln -s "$(HOME=/opt/hf hyperframes browser path | tail -1)" /opt/hf/chrome \
    && chmod -R a+rX /opt/hf \
    && /opt/hf/chrome --version
ENV HYPERFRAMES_BROWSER_PATH=/opt/hf/chrome
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# mẫu (kèm GSAP 3.14.2) và nhạc đóng sẵn vào image, chỉ đọc
COPY templates ./templates
COPY music ./music
USER node
ENV SHARED_DIR=/shared TEMPLATES_DIR=/app/templates MUSIC_DIR=/app/music WORK_DIR=/tmp/render HOME=/tmp
CMD ["node", "dist/src/main-worker.js"]

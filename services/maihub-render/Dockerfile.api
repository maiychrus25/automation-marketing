# API: nhận việc, kiểm khoá, hàng đợi. Không có Chrome/FFmpeg, không giữ quyền Docker.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
COPY scripts ./scripts
RUN npx tsc -p tsconfig.json \
    && npm prune --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY templates ./templates
# cả manifest và các tệp MP3: api phục vụ nghe thử qua /v1/music/:id
COPY music ./music
# user node (uid 1000) trùng với worker để cùng ghi/đọc thư mục shared
USER node
ENV DATA_DIR=/data SHARED_DIR=/shared TEMPLATES_DIR=/app/templates MUSIC_DIR=/app/music PORT=8080
EXPOSE 8080
CMD ["node", "dist/src/main-api.js"]
